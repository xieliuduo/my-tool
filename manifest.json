{
  "manifest_version": 3,
  "name": "研发工具箱",
  "description": "面向研发人员的全窗口工具箱，提供时间转换、文本与数据对比等常用能力。",
  "version": "0.4.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "研发工具箱",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
